{
  "name": "orbit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"wait-on tcp:127.0.0.1:3001 -t 30000 && npm run web\"",
    "server": "tsx src/server/index.ts",
    "web": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:lint": "npm run lint --prefix web",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:search-status": "tsx scripts/search-status.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260619.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.88",
    "@ai-sdk/deepseek": "^3.0.0",
    "@ai-sdk/openai": "^3.0.76",
    "@hono/node-server": "^1.19.9",
    "ai": "^7.0.3",
    "better-auth": "^1.6.18",
    "better-sqlite3": "^12.10.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "wait-on": "^8.0.3",
    "workers-ai-provider": "^3.2.1"
  }
}
