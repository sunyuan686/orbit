# 复制为 .env 后填写（.env 已在 .gitignore，不会提交）

# Cloudflare Workers AI（本地 Node 推理 + 设置页模型目录）
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Better Auth（加密存储 BYOK API Key；本地 dev 必填，任意 32+ 字符随机串即可）
BETTER_AUTH_SECRET=

# Cloudflare Turnstile 真人验证（在 Cloudflare Turnstile 控制台申请）
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 本地飞书 Webhook 联调（Cloudflare Tunnel quick tunnel → Vite 5173）
# 1. npm run dev
# 2. npm run tunnel  → 复制 https://xxx.trycloudflare.com
# 3. 写入下行并重启 server（ORBIT_PUBLIC_URL 仅影响 Webhook 展示与飞书消息内链接，登录仍走 localhost:5173）
# ORBIT_PUBLIC_URL=https://xxx.trycloudflare.com

# 可选 BYOK（也可在设置页配置）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
