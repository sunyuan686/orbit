{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@orbit/shared": ["./src/shared/index.ts"],
      "@orbit/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "scripts"]
}
